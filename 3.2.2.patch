index 0000000..119f516
--- /dev/null
+++ b/test/dummy/app/channels/importmap_notifications_channel.rb
@@ -0,0 +1,19 @@
+class ImportmapNotificationsChannel < ApplicationCable::Channel
+  def subscribed
+    stream_from "importmap_notifications"
+    transmit(
+      "type" => "system",
+      "message" => "Action Cable connected",
+      "timestamp" => Time.current.iso8601
+    )
+  end
+
+  def receive(data)
+    ActionCable.server.broadcast(
+      "importmap_notifications",
+      "type" => data["type"].presence || "event",
+      "message" => data["message"].presence || "Broadcast received",
+      "timestamp" => Time.current.iso8601
+    )
+  end
+end
diff --git a/test/dummy/app/javascript/channels/consumer.js b/test/dummy/app/javascript/channels/consumer.js
