+++ nginx.importmap-propshaft.conf
@@ -0,0 +1,18 @@
+location = /assets/importmap.json {
+  try_files $uri =404;
+  expires -1;
+  add_header Cache-Control "no-store, max-age=0, must-revalidate" always;
+  add_header Surrogate-Control "no-store" always;
+}
+
+location ~ ^/assets/importmap-[0-9a-f]{16}\.json$ {
+  try_files $uri =404;
+  expires 1y;
+  add_header Cache-Control "public, max-age=31536000, immutable" always;
+}
+
+location ~ ^/assets/.+-[0-9a-f]{7,}\.(js|css|png|jpg|jpeg|gif|svg|webp|woff2?)$ {
+  try_files $uri =404;
+  expires 1y;
+  add_header Cache-Control "public, max-age=31536000, immutable" always;
+}
