+++ b/app/javascript/application.tsx
@@ -0,0 +1,22 @@
+import React, { lazy, Suspense } from 'react';
+import { injectDynamicModule } from './utils/importmapInjector';
+
+// 预定义的动态资源注册表（可由后端渲染或前端静态配置）
+const CDN_REGISTRY = {
+  'react-data-grid': {
+    url: 'https://ga.jspm.io/npm:react-data-grid@7.0.0/lib/index.js',
+    sri: 'sha384-xyz123' // 示例 SRI hash
+  }
+};
+
+// 动态注入 CDN 模块并加载组件
+const LazyDataGrid = lazy(async () => {
+  const { url, sri } = CDN_REGISTRY['react-data-grid'];
+  await injectDynamicModule('react-data-grid', url, sri);
+  return import('react-data-grid');
+});
+
+export const App = () => (
+  <Suspense fallback={<div>Loading DataGrid...</div>}>
+    <LazyDataGrid />
+  </Suspense>
+);
