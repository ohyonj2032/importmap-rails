@@ -0,0 +1,21 @@
+export const injectDynamicModule = async (
+  moduleName: string, 
+  cdnUrl: string, 
+  integrity?: string
+): Promise<void> => {
+  // 检查是否已存在该模块的映射
+  if (document.querySelector(`script[data-dynamic-module="${moduleName}"]`)) {
+    return;
+  }
+
+  const importMap = {
+    imports: { [moduleName]: cdnUrl },
+    ...(integrity && { integrity: { [cdnUrl]: integrity } })
+  };
+
+  const script = document.createElement('script');
+  script.type = 'importmap';
+  script.dataset.dynamicModule = moduleName;
+  script.textContent = JSON.stringify(importMap);
+  
+  document.head.appendChild(script);
+  
+  // 给 es-module-shims 留出解析合并的时间
+  await Promise.resolve();
+};
diff --git a/app/javascript/application.tsx b/app/javascript/application.tsx
