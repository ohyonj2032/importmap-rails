diff --git a/test/dummy/app/javascript/application.js b/test/dummy/app/javascript/application.js
index e69de29..4727ee1 100644
--- a/test/dummy/app/javascript/application.js
+++ b/test/dummy/app/javascript/application.js
@@ -0,0 +1,14 @@
+import { startApplication, stopApplication } from "@app/bootstrap"
+
+const mount = () => startApplication()
+const unmount = () => stopApplication()
+
+document.addEventListener("turbo:before-render", unmount)
+document.addEventListener("turbo:before-cache", unmount)
+document.addEventListener("turbo:load", mount)
+
+if (document.readyState === "loading") {
+  document.addEventListener("DOMContentLoaded", mount, { once: true })
+} else {
+  mount()
+}
