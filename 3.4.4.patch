diff --git a/scripts/esbuild-watch.js b/scripts/esbuild-watch.js
new file mode 100644
index 0000000..f7c5f08
--- /dev/null
+++ b/scripts/esbuild-watch.js
@@ -0,0 +1,100 @@
+const esbuild = require("esbuild");
+const fs = require("fs");
+const path = require("path");
+
+const BUILD_DIR = path.resolve(__dirname, "../app/assets/builds");
+const SRC_DIRS = [
+  path.resolve(__dirname, "../app/javascript"),
+  path.resolve(__dirname, "../app/components"),
+];
+
+fs.mkdirSync(BUILD_DIR, { recursive: true });
+fs.writeFileSync(path.join(BUILD_DIR, ".keep"), "");
+
+const ctx = await esbuild.context({
+  entryPoints: findEntryPoints(SRC_DIRS),
+  outdir: BUILD_DIR,
+  bundle: false,
+  format: "esm",
+  target: ["es2020"],
+  sourcemap: "inline",
+  platform: "browser",
+  loader: {
+    ".ts": "ts",
+    ".tsx": "tsx",
+  },
+  logLevel: "info",
+  plugins: [touchManifestPlugin()],
+});
+
+await ctx.watch();
+console.log("[esbuild] Watching TypeScript sources...");
+
+function findEntryPoints(dirs) {
+  const entries = [];
+  for (const dir of dirs) {
+    if (!fs.existsSync(dir)) continue;
+    walkDir(dir, (file) => {
+      if (/\.(ts|tsx)$/.test(file) && !file.endsWith(".d.ts")) {
+        entries.push(file);
+      }
+    });
+  }
+  return entries;
+}
+
+function walkDir(dir, callback) {
+  const files = fs.readdirSync(dir, { withFileTypes: true });
+  for (const f of files) {
+    const fullPath = path.join(dir, f.name);
+    if (f.isDirectory()) {
+      walkDir(fullPath, callback);
+    } else {
+      callback(fullPath);
+    }
+  }
+}
+
+function touchManifestPlugin() {
+  return {
+    name: "touch-manifest",
+    setup(build) {
+      build.onEnd((result) => {
+        if (result.errors.length > 0) return;
+
+        const filesToTouch = [
+          path.resolve(__dirname, "../app/assets/config/manifest.js"),
+          ...(result.outputFiles || []).map((f) => f.path),
+        ];
+
+        for (const file of filesToTouch) {
+          if (fs.existsSync(file)) {
+            const now = new Date();
+            fs.utimesSync(file, now, now);
+          }
+        }
+      });
+    },
+  };
+}
diff --git a/app/javascript/controllers/dynamic_import_map_controller.js b/app/javascript/controllers/dynamic_import_map_controller.js
new file mode 100644
index 0000000..53e206a
--- /dev/null
+++ b/app/javascript/controllers/dynamic_import_map_controller.js
@@ -0,0 +1,68 @@
+import { Controller } from "@hotwired/stimulus";
+
+export default class extends Controller {
+  static values = {
+    imports: Object,
+    integrity: Object,
+    scope: String,
+  };
+
+  connect() {
+    this.injectImportMap();
+  }
+
+  injectImportMap() {
+    const existingMap = document.querySelector(
+      `script[type="importmap"][data-dynamic="true"]`
+    );
+    if (existingMap) return;
+
+    const map = { imports: this.importsValue };
+    if (this.hasIntegrityValue) {
+      map.integrity = this.integrityValue;
+    }
+    if (this.hasScopeValue) {
+      map.scopes = JSON.parse(this.scopeValue);
+    }
+
+    const script = document.createElement("script");
+    script.type = "importmap";
+    script.dataset.dynamic = "true";
+    script.textContent = JSON.stringify(map);
+    document.head.appendChild(script);
+  }
+
+  static injectModule(name, url, integrity = null) {
+    const existingMap = document.querySelector(
+      `script[type="importmap"][data-dynamic="true"]`
+    );
+
+    if (existingMap) {
+      const map = JSON.parse(existingMap.textContent);
+      map.imports = map.imports || {};
+      map.imports[name] = url;
+
+      if (integrity) {
+        map.integrity = map.integrity || {};
+        map.integrity[url] = integrity;
+      }
+
+      existingMap.textContent = JSON.stringify(map);
+    } else {
+      const script = document.createElement("script");
+      script.type = "importmap";
+      script.dataset.dynamic = "true";
+
+      const map = { imports: { [name]: url } };
+      if (integrity) {
+        map.integrity = { [url]: integrity };
+      }
+
+      script.textContent = JSON.stringify(map);
+      document.head.appendChild(script);
+    }
+  }
+}
diff --git a/app/javascript/lib/lazy_import.ts b/app/javascript/lib/lazy_import.ts
new file mode 100644
index 0000000..216e5a5
--- /dev/null
+++ b/app/javascript/lib/lazy_import.ts
@@ -0,0 +1,65 @@
+import DynamicImportMapController from "../controllers/dynamic_import_map_controller";
+
+interface LazyImportOptions {
+  name: string;
+  url: string;
+  integrity?: string;
+  fallback?: string;
+  timeout?: number;
+}
+
+export async function lazyImport(options: LazyImportOptions): Promise<any> {
+  const { name, url, integrity, timeout = 10000 } = options;
+
+  DynamicImportMapController.injectModule(name, url, integrity);
+
+  await waitForImportMapReady(name);
+
+  const controller = new AbortController();
+  const timer = setTimeout(() => controller.abort(), timeout);
+
+  try {
+    const module = await import(name);
+    clearTimeout(timer);
+    return module;
+  } catch (error) {
+    clearTimeout(timer);
+    if (options.fallback) {
+      console.warn(`[lazyImport] Failed to load "${name}", using fallback`);
+      return { default: () => options.fallback };
+    }
+    throw error;
+  }
+}
+
+function waitForImportMapReady(name: string, maxRetries = 50): Promise<void> {
+  return new Promise((resolve) => {
+    let attempts = 0;
+    const check = () => {
+      attempts++;
+      const importMap = document.querySelectorAll<HTMLScriptElement>(
+        'script[type="importmap"]'
+      );
+      if (importMap.length > 0) {
+        queueMicrotask(() => resolve());
+        return;
+      }
+      if (attempts >= maxRetries) {
+        resolve();
+        return;
+      }
+      setTimeout(check, 50);
+    };
+    check();
+  });
+}
diff --git a/app/javascript/lib/sri_validator.ts b/app/javascript/lib/sri_validator.ts
new file mode 100644
index 0000000..d3e8c2a
--- /dev/null
+++ b/app/javascript/lib/sri_validator.ts
@@ -0,0 +1,73 @@
+import DynamicImportMapController from "../controllers/dynamic_import_map_controller";
+
+interface SRIEntry {
+  url: string;
+  hash: string;
+}
+
+export async function validateAndImport(
+  url: string,
+  expectedIntegrity: string,
+  moduleName: string
+): Promise<void> {
+  const response = await fetch(url);
+
+  if (!response.ok) {
+    throw new Error(`[SRI] Failed to fetch ${url}: ${response.status}`);
+  }
+
+  const blob = await response.blob();
+  const actualHash = await computeSRIHash(blob, expectedIntegrity);
+
+  if (!compareHashes(actualHash, expectedIntegrity)) {
+    throw new Error(
+      `[SRI] Integrity mismatch for ${moduleName}: expected ${expectedIntegrity}, got ${actualHash}`
+    );
+  }
+
+  const blobUrl = URL.createObjectURL(blob);
+  DynamicImportMapController.injectModule(moduleName, blobUrl);
+}
+
+async function computeSRIHash(
+  blob: Blob,
+  expectedIntegrity: string
+): Promise<string> {
+  let algorithm: AlgorithmIdentifier;
+  if (expectedIntegrity.startsWith("sha384")) {
+    algorithm = "SHA-384";
+  } else if (expectedIntegrity.startsWith("sha256")) {
+    algorithm = "SHA-256";
+  } else {
+    algorithm = "SHA-512";
+  }
+
+  const buffer = await blob.arrayBuffer();
+  const hashBuffer = await crypto.subtle.digest(algorithm, buffer);
+  const hashArray = Array.from(new Uint8Array(hashBuffer));
+  const hashBase64 = btoa(String.fromCharCode(...hashArray));
+
+  const prefix = algorithm.toLowerCase().replace("-", "");
+  return `${prefix}-${hashBase64}`;
+}
+
+function compareHashes(actual: string, expected: string): boolean {
+  const normalize = (h: string) => h.replace(/^sha(256|384|512)-/i, "sha$1-");
+  return normalize(actual) === normalize(expected);
+}
