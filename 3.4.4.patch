+module DynamicImportmapHelper
+  def dynamic_import_map_tag(modules)
+    imports = modules.each_with_object({}) do |(name, opts), hash|
+      hash[name] = opts[:url]
+    end
+
+    integrity = modules.each_with_object({}) do |(name, opts), hash|
+      hash[opts[:url]] = opts[:integrity] if opts[:integrity]
+    end
+
+    tag.div(
+      data: {
+        controller: "dynamic-import-map",
+        dynamic_import_map_imports_value: imports.to_json,
+        dynamic_import_map_integrity_value: integrity.presence&.to_json
+      }
+    )
+  end
+end