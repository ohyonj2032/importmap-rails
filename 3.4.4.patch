new file mode 100644
index 0000000..c7e7b2d
--- /dev/null
+++ b/app/javascript/lib/hmr.ts
@@ -0,0 +1,60 @@
+interface HMRModule {
+  hot?: {
+    accept(callback?: () => void): void;
+    dispose(callback: () => void): void;
+  };
+}
+
+declare const module: HMRModule;
+
+export function setupHMR() {
+  if (process.env.NODE_ENV !== "development") return;
+
+  if (typeof WebSocket === "undefined") {
+    startPollingReload();
+    return;
+  }
+
+  const ws = new WebSocket(`ws://${location.host}/hmr`);
+
+  ws.addEventListener("message", async (event) => {
+    const data = JSON.parse(event.data);
+
+    if (data.type === "update" && data.modules) {
+      for (const mod of data.modules) {
+        try {
+          const url = `${mod}?t=${Date.now()}`;
+          await import(url);
+          console.log(`[HMR] Updated: ${mod}`);
+        } catch (err) {
+          console.error(`[HMR] Failed to update ${mod}:`, err);
+          location.reload();
+        }
+      }
+    } else if (data.type === "reload") {
+      location.reload();
+    }
+  });
+
+  ws.addEventListener("close", () => {
+    startPollingReload();
+  });
+}
+
+function startPollingReload() {
+  let lastDigest = "";
+  setInterval(async () => {
+    try {
+      const response = await fetch("/importmap-digest.json");
+      const { digest } = await response.json();
+      if (lastDigest && lastDigest !== digest) {
+        location.reload();
+      }
+      lastDigest = digest;
+    } catch {}
+  }, 1000);
+}
diff --git a/app/javascript/components/AsyncComponent.tsx b/app/javascript/components/AsyncComponent.tsx
new file mode 100644
index 0000000..f956f0e
--- /dev/null
+++ b/app/javascript/components/AsyncComponent.tsx
@@ -0,0 +1,48 @@
+import React, { Suspense, lazy, ComponentType } from "react";
+import { lazyImport } from "../lib/lazy_import";
+
+interface AsyncComponentProps {
+  moduleName: string;
+  moduleUrl: string;
+  integrity?: string;
+  exportName?: string;
+  loading?: React.ReactNode;
+  errorFallback?: React.ReactNode;
+}
+
+export function createAsyncComponent(options: {
+  moduleName: string;
+  moduleUrl: string;
+  integrity?: string;
+  exportName?: string;
+}): ComponentType<any> {
+  const LazyComponent = lazy(() =>
+    lazyImport({
+      name: options.moduleName,
+      url: options.moduleUrl,
+      integrity: options.integrity,
+    }).then((mod) => ({
+      default: options.exportName ? mod[options.exportName] : mod.default || mod,
+    }))
+  );
+
+  return function AsyncComponent(props: any) {
+    return (
+      <Suspense fallback={<div>Loading...</div>}>
+        <LazyComponent {...props} />
+      </Suspense>
+    );
+  };
+}
