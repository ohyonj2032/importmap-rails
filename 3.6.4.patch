diff --git a/config/nginx/sites-available/rails_production.conf b/config/nginx/sites-available/rails_production.conf
new file mode 100644
index 0000000..f6a7b8c
--- /dev/null
+++ b/config/nginx/sites-available/rails_production.conf
@@ -0,0 +1,164 @@
+upstream rails_app {
+    server unix:/app/tmp/sockets/puma.sock fail_timeout=0;
+}
+
+# ============================================================
+# Map 定义：按 Propshaft 指纹分发缓存策略
+# ============================================================
+map $uri $propshaft_cache_policy {
+    # Propshaft 编译产物：文件名含内容哈希，永不过期
+    ~^/assets/.*-[a-f0-9]{32,}\.(js|css|png|jpg|svg|woff2)$  "immutable";
+
+    # importmap / manifest 文件：与部署版本绑定
+    ~^/assets/\.manifest\.json$  "manifest";
+    ~^/assets/\.sri_manifest\.json$ "manifest";
+
+    # HTML 页面（内嵌 importmap）：短 TTL + ETag 驱动重验证
+    default  "dynamic";
+}
+
+map $uri $cache_ttl {
+    "immutable"  31536000;   # 1 年（内容指纹保证唯一性）
+    "manifest"   60;          # 60s，确保 CDN 快速感知部署
+    "dynamic"    0;           # 不缓存（或极短），靠 ETag 条件请求
+}
+
+# ============================================================
+# 后端: 注入 X-Asset-Manifest-Etag 响应头
+# ============================================================
+server {
+    listen 80;
+    server_name _;
+
+    root /app/public;
+
+    # --- CDN 信任代理：解读真实客户端 IP ---
+    set_real_ip_from 10.0.0.0/8;
+    set_real_ip_from 172.16.0.0/12;
+    real_ip_header    X-Forwarded-For;
+
+    # --- 静态资源：直接由 Nginx 服务 ---
+    location /assets/ {
+        # 指向 Propshaft 编译输出目录
+        alias /app/public/assets/;
+
+        # immutable 文件：强缓存 + 不验证
+        location ~ ^/assets/.*-[a-f0-9]{32,}\.(js|css|png|jpg|svg|woff2|woff|ttf|eot)$ {
+            expires max;
+            add_header Cache-Control "public, immutable, max-age=31536000";
+            add_header X-Asset-Type "immutable";
+            add_header Vary "Accept-Encoding";
+            gzip_static on;
+            brotli_static on;
+            try_files $uri =404;
+        }
+
+        # manifest 文件：缓存但允许快速更新
+        location ~ ^/assets/\..*\.json$ {
+            expires 60s;
+            add_header Cache-Control "public, max-age=60, must-revalidate";
+            add_header X-Asset-Type "manifest";
+            try_files $uri =404;
+        }
+
+        # 非指纹文件兜底
+        expires 1h;
+        add_header Cache-Control "public, max-age=3600";
+        add_header X-Asset-Type "unversioned";
+        try_files $uri =404;
+    }
+
+    # --- 动态请求：代理到 Rails ---
+    location / {
+        try_files $uri @rails;
+    }
+
+    location @rails {
+        proxy_pass http://rails_app;
+        proxy_set_header Host $host;
+        proxy_set_header X-Real-IP $remote_addr;
+        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
+        proxy_set_header X-Forwarded-Proto $scheme;
+        proxy_set_header X-Request-Start "t=${msec}";
+
+        # 关键: 禁用 Nginx 自身的缓冲以确保响应流式传递
+        proxy_buffering off;
+
+        # ============================================================
+        # HTML 页面缓存策略（内嵌 importmap）
+        # 策略: 不设 max-age，完全依赖 ETag + If-None-Match
+        # 每次部署后 manifest 变更 → ETag 变 → CDN 回源
+        # ============================================================
+        proxy_cache_bypass $http_cache_control;
+
+        # Puma/Rails 在响应中已设置 ETag（importmap-rails 的 digest 机制）
+        # Nginx 原样传递，不做额外缓存
+        add_header Cache-Control "public, no-cache, must-revalidate";
+        add_header X-Deploy-Epoch "${ASSET_MANIFEST_ETAG}";
+    }
+}
+
+# ============================================================
+# CDN 前置缓存层（CloudFront / Fastly / 自建 Varnish）
+# ============================================================
+# 此段为 CDN 配置伪代码，适配常见 CDN 供应商：
+#
+# 规则 1: /assets/*-{hash32}.(js|css)
+#   Cache TTL: 365 天
+#   Cache Key: 仅 URL（hash 已区分版本）
+#
+# 规则 2: /assets/.manifest.json, /assets/.sri_manifest.json
+#   Cache TTL: 60 秒
+#   Cache Key: URL
+#   Stale-while-revalidate: 30 秒
+#
+# 规则 3: /*.html, /
+#   Cache TTL: 0（不缓存或仅用 ETag）
+#   Forward: If-None-Match, If-Modified-Since
+#   逻辑: 304 Not Modified 时由 CDN 边缘直接返回
+#
+# 规则 4: 部署后 CDN 缓存失效
+#   POST_DEPLOY: 对 /assets/.manifest.json 执行硬刷新
+#   curl -X PURGE https://cdn.example.com/assets/.manifest.json
+#
+# ============================================================
+# 三方案协同工作流
+# ============================================================
+#
+# ┌─────────────────────────────────────────────────────────────┐
+# │  CI Pipeline (GitHub Actions)                                │
+# │                                                              │
+# │  1. jspm-sri-lock.yml 运行                                  │
+# │     ├── JSPM API 解析 CDN URL                               │
+# │     ├── 下载 → vendor → SHA-384 计算                         │
+# │     ├── 回写 config/importmap.rb (URL→SRI 硬编码)            │
+# │     └── 提交 config/jspm.lock                                │
+# │                          ↓                                   │
+# │  2. Docker Build (Dockerfile 5-stage)                        │
+# │     ├── Stage 2: esbuild 编译 TS→JS                          │
+# │     ├── Stage 3: assets:precompile (Propshaft 指纹)          │
+# │     ├── Stage 4: sri-lock (SHA-384 预计算 → .sri_manifest)   │
+# │     └── Stage 5: 生产镜像 (含完整 manifest + lock)           │
+# │                          ↓                                   │
+# │  3. Deploy                                                  │
+# │     ├── Nginx 启动 (注入 ASSET_MANIFEST_ETAG)                │
+# │     ├── CDN 刷新 .manifest.json 边缘缓存                      │
+# │     └── ETag 驱动 HTML 页面 CDN 回源                         │
+# │                                                              │
+# │  结果: importmap 中的 SRI 哈希 = 实际文件 SHA-384            │
+# │        CDN 边缘节点 = 当前部署版本资产                        │
+# │        Safari SRI 校验 = 100% 通过                           │
+# └─────────────────────────────────────────────────────────────┘