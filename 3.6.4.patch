+++ b/.github/workflows/jspm-sri-lock.yml
@@ -0,0 +1,214 @@
+name: JSPM SRI Lock
+
+on:
+  push:
+    paths:
+      - "config/importmap.rb"
+  schedule:
+    - cron: "0 6 * * 1"  # 每周一 UTC 6:00 例行刷新
+  workflow_dispatch:
+
+jobs:
+  lock-jspm-dependencies:
+    runs-on: ubuntu-latest
+    timeout-minutes: 15
+
+    steps:
+      - uses: actions/checkout@v4
+
+      - uses: ruby/setup-ruby@v1
+        with:
+          ruby-version: "3.3"
+          bundler-cache: true
+
+      # -------------------------------------------------------
+      # Step 1: 解析 config/importmap.rb 中所有 CDN 依赖
+      # -------------------------------------------------------
+      - name: Extract CDN Dependencies
+        id: extract
+        run: |
+          ruby -e '
+            require "json"
+
+            importmap_rb = File.read("config/importmap.rb")
+            pins = importmap_rb.scan(
+              /pin\s+"([^"]+)"\s*,\s*to:\s*"(https?:\/\/[^"]+)"/
+            )
+
+            cdn_pins = pins.select { |_, url|
+              url.include?("cdn.jspm.io") ||
+              url.include?("ga.jspm.io") ||
+              url.include?("skypack.dev")
+            }
+
+            File.write("tmp/cdn_pins.json", JSON.pretty_generate(cdn_pins.to_h))
+            puts "Found #{cdn_pins.size} CDN dependencies"
+          '
+
+      # -------------------------------------------------------
+      # Step 2: 通过 JSPM generate API 获取权威 URL
+      # -------------------------------------------------------
+      - name: Resolve via JSPM API
+        run: |
+          ruby -e '
+            require "json"
+            require "net/http"
+            require "uri"
+
+            pins = JSON.parse(File.read("tmp/cdn_pins.json"))
+
+            packages = pins.keys
+            if packages.empty?
+              puts "No CDN packages to resolve"
+              File.write("tmp/jspm_resolved.json", "{}")
+              exit 0
+            end
+
+            uri  = URI("https://api.jspm.io/generate")
+            http = Net::HTTP.new(uri.host, uri.port)
+            http.use_ssl = true
+
+            body = {
+              "install"      => packages,
+              "flattenScope" => true,
+              "env"          => ["browser", "module", "production"],
+              "provider"     => "jspm.io"
+            }.to_json
+
+            response = http.post(uri.path, body,
+              { "Content-Type" => "application/json" })
+
+            if response.code == "200"
+              imports = JSON.parse(response.body).dig("map", "imports")
+              File.write("tmp/jspm_resolved.json",
+                JSON.pretty_generate(imports))
+              puts "Resolved #{imports.size} packages"
+
+              imports.each do |name, url|
+                puts "  #{name} => #{url}"
+              end
+            else
+              puts "JSPM API error: #{response.code} #{response.body[0..200]}"
+              exit 1
+            end
+          '
+
+      # -------------------------------------------------------
+      # Step 3: 下载每个 CDN 包并计算 SRI (SHA-384)
+      # -------------------------------------------------------
+      - name: Download & Compute SRI
+        run: |
+          ruby -e '
+            require "json"
+            require "net/http"
+            require "uri"
+            require "digest"
+            require "fileutils"
+
+            resolved = JSON.parse(File.read("tmp/jspm_resolved.json"))
+            if resolved.empty?
+              File.write("config/jspm.lock", "{}")
+              exit 0
+            end
+
+            lock = {}
+
+            resolved.each do |package, url|
+              uri  = URI(url)
+              http = Net::HTTP.new(uri.host, uri.port)
+              http.use_ssl = true
+
+              body = nil
+              3.times do |attempt|
+                begin
+                  response = http.get(uri.request_uri)
+                  if response.code == "200"
+                    body = response.body
+                    break
+                  else
+                    puts "  Retry #{attempt + 1}/3 for #{package}: HTTP #{response.code}"
+                  end
+                rescue => e
+                  puts "  Retry #{attempt + 1}/3 for #{package}: #{e.message}"
+                end
+                sleep(2)
+              end
+
+              if body.nil?
+                puts "  FAILED: #{package} from #{url}"
+                next
+              end
+
+              sha384 = Digest::SHA384.base64digest(body)
+
+              vendor_dir = "vendor/javascript/jspm"
+              FileUtils.mkdir_p(vendor_dir)
+              vendor_path = "#{vendor_dir}/#{package}.js"
+              File.write(vendor_path, body)
+
+              lock[package] = {
+                "url"       => url,
+                "integrity" => "sha384-#{sha384}",
+                "vendor"    => vendor_path,
+                "bytes"     => body.bytesize,
+                "resolved_at" => Time.now.utc.iso8601
+              }
+
+              puts "  #{package}: sha384-#{sha384[0..15]}... (#{body.bytesize}B)"
+            end
+
+            File.write("config/jspm.lock",
+              JSON.pretty_generate(lock))
+            puts "\nJSPM lock written: config/jspm.lock (#{lock.size} entries)"
+          '
+
+      # -------------------------------------------------------
+      # Step 4: 基于 lock 文件回写 config/importmap.rb
+      # -------------------------------------------------------
+      - name: Update importmap.rb with Locked URLs and SRI
+        run: |
+          ruby -e '
+            require "json"
+
+            lock = JSON.parse(File.read("config/jspm.lock"))
+            return if lock.empty?
+
+            importmap_path = "config/importmap.rb"
+            content = File.read(importmap_path)
+
+            lock.each do |package, entry|
+              url       = entry["url"]
+              integrity = entry["integrity"]
+
+              content.gsub!(
+                /pin\s+"#{Regexp.escape(package)}"\s*,\s*to:\s*"https?:\/\/[^"]+"/,
+                %(pin "#{package}", to: "#{url}")
+              )
+
+              pin_pattern = /pin\s+"#{Regexp.escape(package)}"(.*)$/
+              if content.match?(pin_pattern)
+                line = content.match(pin_pattern)[0]
+                if line.include?("integrity:")
+                  content.gsub!(
+                    /(pin\s+"#{Regexp.escape(package)}".*integrity:\s*)[^,\n]+/,
+                    %(\\1"#{integrity}")
+                  )
+                else
+                  content.gsub!(
+                    /(pin\s+"#{Regexp.escape(package)}"[^\n]*)/,
+                    %(\\1, integrity: "#{integrity}")
+                  )
+                end
+              end
+            end
+
+            File.write(importmap_path, content)
+            puts "Updated config/importmap.rb with locked URLs and SRI hashes"
+          '
+
+      # -------------------------------------------------------
+      # Step 5: 验证 — 用 lock 中的 URL 再次下载并校验 SRI
+      # -------------------------------------------------------
+      - name: Verify SRI Integrity
+        run: |
+          ruby -e '
+            require "json"
+            require "net/http"
+            require "uri"
+            require "digest"
+
+            lock = JSON.parse(File.read("config/jspm.lock"))
+            failures = []
+
+            lock.each do |package, entry|
+              url  = entry["url"]
+              expected = entry["integrity"]
+
+              uri  = URI(url)
+              http = Net::HTTP.new(uri.host, uri.port)
+              http.use_ssl = true
+
+              response = http.get(uri.request_uri)
+              if response.code != "200"
+                failures << "#{package}: HTTP #{response.code}"
+                next
+              end
+
+              actual = "sha384-#{Digest::SHA384.base64digest(response.body)}"
+              if actual != expected
+                failures << "#{package}: SRI mismatch\n  expected: #{expected}\n  actual:   #{actual}"
+              else
+                puts "  #{package}: VERIFIED"
+              end
+            end
+
+            if failures.any?
+              puts "\nSRI VERIFICATION FAILED:"
+              failures.each { |f| puts "  #{f}" }
+              exit 1
+            else
+              puts "\nAll #{lock.size} packages verified"
+            end
+          '
+
+      # -------------------------------------------------------
+      # Step 6: 提交 lock 文件变更
+      # -------------------------------------------------------
+      - name: Commit Lock File
+        if: github.event_name != 'pull_request'
+        uses: stefanzweifel/git-auto-commit-action@v5
+        with:
+          commit_message: "chore: update JSPM SRI lock [skip ci]"
+          file_pattern: "config/jspm.lock config/importmap.rb vendor/javascript/jspm/"
+          commit_user_name: "CI Bot"
+          commit_user_email: "ci@github-actions"
diff --git a/config/initializers/importmap_sri.rb b/config/initializers/importmap_sri.rb
new file mode 100644
index 0000000..c3d4e5f
--- /dev/null
+++ b/config/initializers/importmap_sri.rb
@@ -0,0 +1,40 @@
+require "digest"
+require "json"
+
+module ImportmapSriEnhancement
+  def self.load_sri_manifest!
+    @sri_manifest ||= begin
+      path = Rails.root.join("public/assets/.sri_manifest.json")
+      if File.exist?(path)
+        JSON.parse(File.read(path))
+      else
+        {}
+      end
+    end
+  end
+
+  def sri_manifest
+    ImportmapSriEnhancement.load_sri_manifest!
+  end
+end
+
+Rails.application.config.after_initialize do
+  ImportmapSriEnhancement.load_sri_manifest!
+end
+
+Rails.application.config.after_initialize do
+  if defined?(Propshaft::Assembly)
+    Propshaft::Assembly.prepend(Module.new do
+      def integrity(path)
+        manifest = ImportmapSriEnhancement.load_sri_manifest!
+        digested = reveal(path)
+        manifest[digested] || super(path)
+      rescue => e
+        Rails.logger.warn("[SRI] fallback to runtime: #{e.message}")
+        super(path)
+      end
+    end)
+  end
+end
