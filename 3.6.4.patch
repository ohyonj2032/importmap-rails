+# syntax=docker/dockerfile:1
+
+# ============================================================
+# Stage 1: build-deps — 安装所有构建依赖
+# ============================================================
+FROM ruby:3.3-slim AS build-deps
+WORKDIR /app
+
+RUN apt-get update -qq && \
+    apt-get install -y --no-install-recommends \
+      build-essential curl git nodejs npm && \
+    rm -rf /var/lib/apt/lists/*
+
+COPY Gemfile Gemfile.lock ./
+RUN bundle config set --local deployment true && \
+    bundle install --jobs=4 --retry=3
+
+COPY package.json package-lock.json ./
+RUN npm ci
+
+# ============================================================
+# Stage 2: esbuild-compile — 编译 TypeScript/JS
+# ============================================================
+FROM build-deps AS esbuild-compile
+WORKDIR /app
+COPY --from=build-deps /usr/local/bundle /usr/local/bundle
+COPY --from=build-deps /app/node_modules /app/node_modules
+COPY . .
+
+RUN npm run build
+# 此时 app/assets/builds/ 中已有编译产物
+
+# ============================================================
+# Stage 3: assets-precompile — Propshaft 指纹化
+# ============================================================
+FROM esbuild-compile AS assets-precompile
+WORKDIR /app
+
+ENV RAILS_ENV=production
+ENV RAILS_MASTER_KEY=dummy-for-precompile
+
+RUN SECRET_KEY_BASE_DUMMY=1 \
+    bundle exec rails assets:precompile
+# Propshaft 此时生成 public/assets/.manifest.json
+# 包含所有编译产物的内容摘要指纹
+
+# ============================================================
+# Stage 4: sri-lock — SRI 哈希预计算与注入
+# ============================================================
+FROM assets-precompile AS sri-lock
+WORKDIR /app
+
+# 4.1: 对本地 JS 资源: 计算 SHA-384 SRI 并写入 manifest
+RUN bundle exec ruby -e '
+  require "digest"
+  require "json"
+
+  manifest_path = "public/assets/.manifest.json"
+  manifest = JSON.parse(File.read(manifest_path))
+
+  sri_lock = {}
+  manifest.each do |logical, digested|
+    file_path = "public/assets/#{digested}"
+    next unless File.exist?(file_path) && digested.end_with?(".js")
+
+    content  = File.read(file_path)
+    sha384   = Digest::SHA384.base64digest(content)
+    sri_lock[digested] = "sha384-#{sha384}"
+  end
+
+  File.write("public/assets/.sri_manifest.json",
+             JSON.pretty_generate(sri_lock))
+  puts "SRI lock generated for #{sri_lock.size} assets"
+'
+
+# 4.2: 对 CDN 依赖: 读取 jspm.lock 中的 URL→SRI 映射
+COPY config/jspm.lock config/jspm.lock
+
+# ============================================================
+# Stage 5: production — 精简运行镜像
+# ============================================================
+FROM ruby:3.3-slim AS production
+WORKDIR /app
+
+RUN apt-get update -qq && \
+    apt-get install -y --no-install-recommends curl libvips && \
+    rm -rf /var/lib/apt/lists/*
+
+COPY --from=sri-lock /usr/local/bundle /usr/local/bundle
+COPY --from=sri-lock /app /app
+
+ENV RAILS_ENV=production
+ENV RAILS_SERVE_STATIC_FILES=true
+
+EXPOSE 3000
+CMD ["bundle", "exec", "rails", "server", "-b", "0.0.0.0"]
