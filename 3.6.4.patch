index 0000000..d4e5f6a
--- /dev/null
+++ b/config/initializers/jspm_lock.rb
@@ -0,0 +1,22 @@
+module JspmLock
+  LOCK_PATH = Rails.root.join("config/jspm.lock")
+
+  def self.load
+    @load ||= begin
+      if File.exist?(LOCK_PATH)
+        JSON.parse(File.read(LOCK_PATH))
+      else
+        Rails.logger.warn("[JSPM] No lock file found at #{LOCK_PATH}")
+        {}
+      end
+    end
+  end
+
+  def self.integrity_for(package)
+    entry = load[package]
+  end
+
+  def self.url_for(package)
+    entry = load[package]
+  end
+end
