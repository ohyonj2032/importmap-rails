--- /dev/null
+++ b/docs/guides/ci_cd_build/nginx.conf
@@ -0,0 +1,98 @@
+# Nginx 配置示例 - 适用于 Rails 7 + Importmap + Propshaft + SRI
+
+upstream rails_app {
+  server 127.0.0.1:3000;
+  keepalive 32;
+}
+
+server {
+  listen 80;
+  listen [::]:80;
+  server_name your-app.example.com;
+  root /app/public;
+
+  # 安全头部配置
+  add_header X-Frame-Options "SAMEORIGIN" always;
+  add_header X-XSS-Protection "1; mode=block" always;
+  add_header X-Content-Type-Options "nosniff" always;
+  add_header Referrer-Policy "strict-origin-when-cross-origin" always;
+  add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdn.jsdelivr.net https://ga.jspm.io; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net;" always;
+
+  # gzip 压缩
+  gzip on;
+  gzip_vary on;
+  gzip_min_length 1024;
+  gzip_types text/plain text/css text/xml text/javascript application/x-javascript application/xml+rss application/json application/javascript;
+
+  # ==================== 关键：Importmap 缓存策略 ====================
+
+  # 1. 动态生成的 importmap.json - NO CACHE
+  # 假设 Rails 应用通过某个路由提供动态 importmap.json
+  location ~* /importmap\.json$ {
+    proxy_pass http://rails_app;
+    proxy_set_header Host $host;
+    proxy_set_header X-Real-IP $remote_addr;
+    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
+    
+    # 禁用缓存，确保每次请求都获取最新的 importmap
+    add_header Cache-Control "no-store, no-cache, must-revalidate, private, max-age=0" always;
+    add_header Pragma "no-cache" always;
+    expires -1;
+    
+    # 防止 ETag 和 Last-Modified 导致 304 缓存
+    add_header ETag "";
+    add_header Last-Modified "";
+    if_modified_since off;
+    etag off;
+  }
+
+  # ==================== Propshaft 带指纹的静态资源 ====================
+
+  # 2. 带指纹的 Propshaft 编译资产 - 永久缓存
+  location ~* ^/assets/.*-[0-9a-f]{32,}.*\.(js|css|png|jpg|jpeg|gif|svg|ico)$ {
+    expires 1y;
+    add_header Cache-Control "public, max-age=31536000, immutable" always;
+    
+    # 启用 try_files 从文件系统直接提供，否则回退到应用
+    try_files $uri @rails;
+  }
+
+  # ==================== Vendor JavaScript ====================
+
+  # 3. Vendor JavaScript 目录 - 中等缓存
+  location ~* ^/assets/.*vendor.*\.(js)$ {
+    expires 7d;
+    add_header Cache-Control "public, max-age=604800" always;
+    try_files $uri @rails;
+  }
+
+  # ==================== 其他静态资源 ====================
+
+  # 4. 不带指纹的常规静态资源 - 短缓存
+  location ~* \.(js|css|png|jpg|jpeg|gif|svg|ico)$ {
+    expires 1h;
+    add_header Cache-Control "public, max-age=3600" always;
+    try_files $uri @rails;
+  }
+
+  # ==================== Rails 应用路由 ====================
+
+  location / {
+    try_files $uri @rails;
+  }
+
+  location @rails {
+    proxy_pass http://rails_app;
+    proxy_set_header Host $host;
+    proxy_set_header X-Real-IP $remote_addr;
+    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
+    proxy_set_header X-Forwarded-Proto $scheme;
+    proxy_ssl_server_name on;
+    
+    # 动态页面不缓存
+    add_header Cache-Control "no-cache, no-store, must-revalidate, private" always;
+    
+    proxy_http_version 1.1;
+    proxy_set_header Connection "";
+  }
+}
