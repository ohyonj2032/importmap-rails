diff --git a/Dockerfile b/Dockerfile
new file mode 100644
index 0000000..e69de29
--- /dev/null
+++ b/Dockerfile
@@ -0,0 +1,32 @@
+# ==========================================
+# Stage 1: Node.js 编译前端资源 (esbuild)
+# ==========================================
+FROM node:18-alpine AS frontend-builder
+WORKDIR /app
+COPY package.json yarn.lock ./
+RUN yarn install --frozen-lockfile
+COPY app/javascript ./app/javascript
+COPY tsconfig.json ./ 
+RUN yarn build
+
+# ==========================================
+# Stage 2: Ruby 环境与资产预编译 (Propshaft)
+# ==========================================
+FROM ruby:3.2-alpine AS assets-builder
+WORKDIR /app
+RUN apk add --no-cache build-base git nodejs tzdata
+COPY Gemfile Gemfile.lock ./
+RUN bundle install --without development test
+COPY . .
+COPY --from=frontend-builder /app/app/assets/builds ./app/assets/builds
+RUN SECRET_KEY_BASE_DUMMY=1 bundle exec rails assets:precompile
+
+# ==========================================
+# Stage 3: 最终生产镜像
+# ==========================================
+FROM ruby:3.2-alpine AS production
+WORKDIR /app
+RUN apk add --no-cache tzdata postgresql-client vips
+COPY --from=assets-builder /usr/local/bundle /usr/local/bundle
+COPY --from=assets-builder /app /app
+ENV RAILS_ENV="production"
+ENV RAILS_SERVE_STATIC_FILES="true"
+EXPOSE 3000
+CMD ["bundle", "exec", "puma", "-C", "config/puma.rb"]
