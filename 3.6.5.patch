+  def compile(resolver:, path: Rails.root.join("public/importmap.json"))
+    json = to_json(resolver: resolver)
+    FileUtils.mkdir_p(File.dirname(path))
+    File.write(path, json)
+    Rails.logger.info "Importmap compiled to #{path} (#{Digest::SHA1.hexdigest(json)})"
+    path
+  end
+
+  def load_compiled(path: Rails.root.join("public/importmap.json"))
+    if File.exist?(path)
+      File.read(path)
+    else
+      nil
+    end
+  end
